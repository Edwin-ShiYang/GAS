			<Notify name="HitStart" time="0.3" />
			<Notify name="HitEnd"   time="0.7" />
			<Notify name="AnimEnd"  isEnd="true" />
		</AnimationSequenceDefinition>

		<AnimationSequenceDefinition id="ComboAttack" animation="Data/Mesh/Player/SK_Player_ComboAttack" rootMotion="true">
			<Notify name="AnimEnd"  isEnd="true" />
